
@model List<BakeHub.Models.Product>
@{
    ViewBag.Title = "Products";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="bubble fixed flex items-center justify-center w-full">
        <div class="flex items-center justify-center w-full">
            <div class="flex w-full max-w-[700px] mt-[30px] items-center justify-center">
                <div class="flex w-full items-center p-4 mb-4 text-sm text-[#4BB543] rounded-[10px] bg-[#b8ffb3] border border-[#4BB543]"
                     style="animation: slideDownUp 4s ease-out forwards;">
                    <svg class="w-4 h-4 me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                         fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span class="font-medium me-1"></span>@TempData["SuccessMessage"]
                </div>
            </div>
        </div>
    </div>
}

<!-- DELETE CONTAINER -->
<div id="deleteModal" class="fixed h-[100vh] hidden items-start p-[100px] items-center justify-center z-999 w-full ">
    <!-- DELETE MODAL -->
    <form action="/product/DeleteProduct" method="POST" class="bg-white shadow-lg px-[45px] flex flex-col gap-[30px] py-[30px] rounded-[20px]">
        <input type="hidden" id="deleteProductId" name="id" />
        <div class="flex flex-col items-center gap-[10px]">
            <div class="rounded-[50%] h-[65px] w-[65px] flex items-center justify-center bg-[rgba(255,56,60,.2)]">
                <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M15.0005 11.2501V16.2501M5.47412 18.9998C4.33733 20.9688 3.7691 21.9537 3.85401 22.7615C3.92807 23.4662 4.29789 24.1063 4.87109 24.5228C5.52803 25.0001 6.66412 25.0001 8.93616 25.0001H21.0648C23.3369 25.0001 24.4728 25.0001 25.1297 24.5228C25.7029 24.1063 26.0729 23.4662 26.147 22.7615C26.2319 21.9537 25.6638 20.9688 24.527 18.9998L18.4648 8.49983C17.3281 6.53085 16.7594 5.54653 16.0173 5.21614C15.3701 4.92795 14.6305 4.92795 13.9832 5.21614C13.2415 5.54639 12.6732 6.53072 11.5373 8.49806L5.47412 18.9998ZM15.064 20.0001V20.1251L14.9382 20.1253V20.0001H15.064Z"
                          stroke="#FF383C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <h3 class="text-[20px] font-semibold">Are you sure?</h3>
            <p class="text-[16px] text-gray-500 font-medium max-w-[357px] text-center">
                This will delete all data about
                <span id="deleteName" class="text-[#FF383C]"></span>. This action cannot be undone.
            </p>
        </div>
        <div class="flex w-full flex-col gap-[15px]">
            <button type="submit" class=" w-full bg-[#FF383C] cursor-pointer hover:bg-[#e03235] transition-all duration-300 text-white text-[16px] font-medium py-[15px] rounded-[6px]">
                Yes, Delete Product
            </button>
            <div id="cancelDeleteBtn"
                 class="w-full cursor-pointer text-center text-gray-600 bg-white hover:bg-gray-100 transition-all duration-300 text-black text-[16px] font-medium py-[15px] rounded-[6px] border border-gray-300">
                Cancel
            </div>
        </div>
    </form>
</div>

<!-- MAIN CONTENT SECTION -->
<section class="w-full pl-[240px]">
    <!-- HEADER -->
    <div class="w-full border-b-[#E0E0E0] border-b-[1px] justify-between items-center flex bg-white px-[28px] py-[7px]">
        <form method="get" action="@Url.Action("products", "product")" class="flex w-fit items-center bg-white border-[1px] rounded-[10px] border-[#E0E0E0]">
            <div class="border-r-[#E0E0E0] border-r-[1px] w-fit px-[30px] py-[25px]">
                <svg width="21" height="24" viewBox="0 0 21 24" fill="none"
                     xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                          d="M10.5 9.75C15.8848 9.75 20.25 7.73528 20.25 5.25C20.25 2.76472 15.8848 0.75 10.5 0.75C5.11522 0.75 0.75 2.76472 0.75 5.25C0.75 7.73528 5.11522 9.75 10.5 9.75Z"
                          stroke="black" stroke-width="1.5" stroke-linecap="round"
                          stroke-linejoin="round" />
                    <path d="M0.75 5.25C0.75253 9.76548 3.85614 13.688 8.25 14.729V21C8.25 22.2426 9.25736 23.25 10.5 23.25C11.7426 23.25 12.75 22.2426 12.75 21V14.729C17.1439 13.688 20.2475 9.76548 20.25 5.25"
                          stroke="black" stroke-width="1.5" stroke-linecap="round"
                          stroke-linejoin="round" />
                </svg>
            </div>
            <div class="border-r-[#E0E0E0] text-[14px] font-medium border-r-[1px] w-fit px-[30px] py-[25px]">
                Filter By
            </div>
            <div class="border-r-[#E0E0E0] group cursor-pointer text-[14px] font-medium border-r-[1px] w-fit px-[30px] py-[25px]">
                <select name="statusFilter"
                        onchange="this.form.submit()"
                        class="focus:outline-none group-hover:cursor-pointer">
                    <option value="">All Categories</option>
                    <option value="1" @(ViewBag.CurrentFilter == 1 ? "selected" : "")>Active</option>
                    <option value="0" @(ViewBag.CurrentFilter == 0 ? "selected" : "")>Hidden</option>
                </select>
            </div>
            <a href="@Url.Action("products", "product")"
               class="flex items-center gap-[10px] group cursor-pointer text-[14px] text-[#EA0234] hover:text-[#c00128] transition-all font-medium w-fit px-[30px] py-[25px]">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none"
                     xmlns="http://www.w3.org/2000/svg">
                    <path d="M9.99992 4.16666V0.833328L5.83325 4.99999L9.99992 9.16666V5.83333C12.7583 5.83333 14.9999 8.07499 14.9999 10.8333C14.9999 13.5917 12.7583 15.8333 9.99992 15.8333C7.24159 15.8333 4.99992 13.5917 4.99992 10.8333H3.33325C3.33325 14.5167 6.31659 17.5 9.99992 17.5C13.6833 17.5 16.6666 14.5167 16.6666 10.8333C16.6666 7.14999 13.6833 4.16666 9.99992 4.16666Z"
                          fill="currentColor" />
                </svg>
                Reset Filter
            </a>
        </form>

        <div class="flex items-center gap-[30px]">
            <div class="relative rounded-[50%] h-[35px] w-[35px] min-w-[35px] w-fit group cursor-pointer hover:bg-gray-200 transition-all duration-300 flex items-center justify-center">
                <svg class="h-[24px] w-[24px]" viewBox="0 0 24 24" fill="none"
                     xmlns="http://www.w3.org/2000/svg">
                    <path d="M18.7491 9.70957V9.00497C18.7491 5.13623 15.7274 2 12 2C8.27256 2 5.25087 5.13623 5.25087 9.00497V9.70957C5.25087 10.5552 5.00972 11.3818 4.5578 12.0854L3.45036 13.8095C2.43882 15.3843 3.21105 17.5249 4.97036 18.0229C9.57274 19.3257 14.4273 19.3257 19.0296 18.0229C20.789 17.5249 21.5612 15.3843 20.5496 13.8095L19.4422 12.0854C18.9903 11.3818 18.7491 10.5552 18.7491 9.70957Z"
                          stroke="#1C274C" stroke-width="1.5" />
                    <path d="M7.5 19C8.15503 20.7478 9.92246 22 12 22C14.0775 22 15.845 20.7478 16.5 19"
                          stroke="#1C274C" stroke-width="1.5" stroke-linecap="round" />
                </svg>
                <div class="h-[15px] absolute top-0 right-0 flex text-[10px] mt-[2px] mr-[2px] text-white items-center justify-center w-[15px] bg-red-600 rounded-[50%]">
                    8
                </div>
            </div>

            <div class="flex gap-[10px] items-center">
                <div class="overflow-hidden rounded-[50%] h-[50px] w-[50px] min-w-[50px]">
                    <img class="h-full w-full object-center object-cover" src="assets/cute pfp cat.jpg" alt="">
                </div>
                <div class="flex flex-col">
                    <h3 class="text-[16px] text-gray-600 font-semibold">Juan Ming</h3>
                    <small class="text-gray-500 text-[12px] font-semibold">Admin</small>
                </div>
            </div>

        </div>


    </div>

    <!-- main info -->
    <div class="w-full flex flex-col gap-[30px] p-[30px]">
        <!-- FILTER -->
        <div class="w-full flex flex-col gap-[20px]">
            <h1 class="text-[32px] font-semibold">Manage Products</h1>
            <!-- FILTER -->
            <div class="w-full flex items-center justify-between">
                <form class="flex w-fit items-center bg-white border-[1px] rounded-[10px] border-[#E0E0E0]">
                    <div class="border-r-[#E0E0E0] border-r-[1px] w-fit px-[30px] py-[25px]">
                        <svg width="21" height="24" viewBox="0 0 21 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd"
                                  d="M10.5 9.75C15.8848 9.75 20.25 7.73528 20.25 5.25C20.25 2.76472 15.8848 0.75 10.5 0.75C5.11522 0.75 0.75 2.76472 0.75 5.25C0.75 7.73528 5.11522 9.75 10.5 9.75Z"
                                  stroke="black" stroke-width="1.5" stroke-linecap="round"
                                  stroke-linejoin="round" />
                            <path d="M0.75 5.25C0.75253 9.76548 3.85614 13.688 8.25 14.729V21C8.25 22.2426 9.25736 23.25 10.5 23.25C11.7426 23.25 12.75 22.2426 12.75 21V14.729C17.1439 13.688 20.2475 9.76548 20.25 5.25"
                                  stroke="black" stroke-width="1.5" stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="border-r-[#E0E0E0] text-[14px] font-medium border-r-[1px] w-fit px-[30px] py-[25px]">
                        Filter By
                    </div>
                    <div class="border-r-[#E0E0E0] group cursor-pointer text-[14px] font-medium border-r-[1px] w-fit px-[30px] py-[25px]">
                        <select class="focus:outline-none group-hover:cursor-pointer" name="" id="">
                            <option value="">Product Category</option>
                        </select>
                    </div>
                    <div class="flex items-center gap-[10px] group cursor-pointer text-[14px] text-[#EA0234] font-medium w-fit px-[30px] py-[25px]">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M9.99992 4.16666V0.833328L5.83325 4.99999L9.99992 9.16666V5.83333C12.7583 5.83333 14.9999 8.07499 14.9999 10.8333C14.9999 13.5917 12.7583 15.8333 9.99992 15.8333C7.24159 15.8333 4.99992 13.5917 4.99992 10.8333H3.33325C3.33325 14.5167 6.31659 17.5 9.99992 17.5C13.6833 17.5 16.6666 14.5167 16.6666 10.8333C16.6666 7.14999 13.6833 4.16666 9.99992 4.16666Z"
                                  fill="#EA0234" />
                        </svg>
                        Reset Filter
                    </div>
                </form>

                <a href="@Url.Action("addProduct", "product")"
                   class="flex bg-white transition-all duration-300 hover:bg-gray-50 cursor-pointer rounded-[10px] border-[1px] border-gray-300 items-center gap-[10px] group cursor-pointer text-[14px] text-black font-medium w-fit px-[30px] py-[25px]">
                    <svg class="w-[20px] h-[20px] stroke-black" width="20" height="20" viewBox="0 0 24 24"
                         fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 3H3.26835C3.74213 3 3.97943 3 4.17267 3.08548C4.34304 3.16084 4.48871 3.28218 4.59375 3.43604C4.71269 3.61026 4.75564 3.8429 4.84137 4.30727L7.00004 16L17.4218 16C17.875 16 18.1023 16 18.29 15.9199C18.4559 15.8492 18.5989 15.7346 18.7051 15.5889C18.8252 15.4242 18.8761 15.2037 18.9777 14.7631L18.9785 14.76L20.5477 7.95996L20.5481 7.95854C20.7023 7.29016 20.7796 6.95515 20.6947 6.69238C20.6202 6.46182 20.4635 6.26634 20.2556 6.14192C20.0184 6 19.6758 6 18.9887 6H5.5M18 21C17.4477 21 17 20.5523 17 20C17 19.4477 17.4477 19 18 19C18.5523 19 19 19.4477 19 20C19 20.5523 18.5523 21 18 21ZM8 21C7.44772 21 7 20.5523 7 20C7 19.4477 7.44772 19 8 19C8.55228 19 9 19.4477 9 20C9 20.5523 8.55228 21 8 21Z"
                              stroke="" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Add new Product
                </a>
            </div>

        </div>
        <!-- TABLE -->
        <div class="w-full p-[30px] rounded-[20px] gap-[20px] bg-white flex flex-col">
            <table class="w-full">
                <thead>
                    <tr class="bg-[#F1F4F9] px-[10px] py-[15px]">
                        <th class="text-[14px] rounded-tl-[10px] rounded-bl-[10px] px-[10px] py-[15px] font-semibold text-start">
                            Product Name
                        </th>
                        <th class="text-[14px] px-[10px] py-[15px] font-semibold text-start">
                            Category
                        </th>
                        <th class="text-[14px] px-[10px] py-[15px] font-semibold text-start">
                            Price
                        </th>
                        <th class="text-[14px] px-[10px] py-[15px] font-semibold text-start">
                            Stock
                        </th>
                        <th class="text-[14px] px-[10px] py-[15px] font-semibold text-start">
                            Status
                        </th>
                        <th class="text-[14px] rounded-tr-[10px] rounded-br-[10px] px-[10px] py-[15px] font-semibold text-start">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td class="text-[14px] px-[10px] py-[15px] font-medium text-gray-700 text-start">
                                @product.Name
                            </td>
                            <td class="text-[14px] px-[10px] py-[15px] font-medium text-gray-700 text-start">
                                Cakes
                            </td>
                            <td class="text-[14px] px-[10px] py-[15px] font-medium text-gray-700 text-start">
                                ₱@product.Price
                            </td>
                            <td class="text-[14px] px-[10px] py-[15px] font-medium text-gray-700 text-start">
                                @product.Stock
                            </td>
                            <td class="text-[14px] px-[10px] py-[15px] font-medium text-gray-700 text-start">
                                <div class="
                                     @(product.Status == 0 ? "text-[#7900b6] bg-[rgb(121,0,182,0.2)]" : "text-[#00B69B] bg-[rgba(0,182,155,.2)]" )
                                     w-fit px-[15px] py-[8px] rounded-[5px]">
                                    @(product.Status == 1 ? "Available" : "Unavailable")
                                </div>
                            </td>
                            <td class="text-[14px] px-[10px] flex items-center gap-[10px] py-[15px] font-medium text-start">
                                <a href="editProduct.html"
                                   class="text-[#FF8D28] hover:bg-[rgba(255,141,40,.3)] transition-all duration-300 cursor-pointer bg-[rgba(255,141,40,.2)] w-fit px-[15px] py-[8px] rounded-[5px]">
                                    Edit
                                </a>
                                <div data-id="@product.Product_id"
                                     data-name="@($"{product.Name}")"
                                     class="openDeleteBtn text-[#FF383C]  hover:bg-[rgba(255,56,60,.3)] transition-all duration-300 cursor-pointer bg-[rgba(255,56,60,.2)] w-fit px-[15px] py-[8px] rounded-[5px]">
                                    Delete
                                </div>
                                <div id="viewBtn"
                                     class="text-[#155dfc] hover:bg-[rgba(21,93,252,.3)] transition-all duration-300 cursor-pointer bg-[rgba(21,93,252,.2)] w-fit px-[15px] py-[8px] rounded-[5px]">
                                    View
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const deleteModal = document.getElementById("deleteModal");
        const deleteProductId = document.getElementById("deleteProductId");
        const deleteName = document.getElementById("deleteName");

        const openButtons = document.querySelectorAll(".openDeleteBtn");
        const cancelDeleteButton = document.getElementById("cancelDeleteBtn");

        openButtons.forEach(btn => {
            btn.addEventListener("click", function () {
                const id = this.getAttribute("data-id");
                const name = this.getAttribute("data-name");

                deleteProductId.value = id;
                deleteName.textContent = name;

                deleteModal.classList.remove("hidden");
                deleteModal.classList.add("flex");
            });
        });

        cancelDeleteButton.addEventListener("click", function () {
            deleteModal.classList.add("hidden");
            deleteModal.classList.remove("flex");
        });

    });
</script>
