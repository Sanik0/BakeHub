
@model List<BakeHub.Models.Product>
@{
    ViewBag.Title = "Products";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="bubble fixed flex items-center justify-center w-full">
        <div class="flex items-center justify-center w-full">
            <div class="flex w-full max-w-[700px] mt-[30px] items-center justify-center">
                <div class="flex w-full items-center p-4 mb-4 text-sm text-[#4BB543] rounded-[10px] bg-[#b8ffb3] border border-[#4BB543]"
                     style="animation: slideDownUp 4s ease-out forwards;">
                    <svg class="w-4 h-4 me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                         fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span class="font-medium me-1"></span>@TempData["SuccessMessage"]
                </div>
            </div>
        </div>
    </div>
}

<!-- DELETE CONTAINER -->
<div id="deleteModal" class="fixed h-[100vh] hidden items-start p-[100px] items-center justify-center z-999 w-full ">
    <!-- DELETE MODAL -->
    <form action="/product/DeleteProduct" method="POST" class="bg-white shadow-lg px-[45px] flex flex-col gap-[30px] py-[30px] rounded-[20px]">
        <input type="hidden" id="deleteProductId" name="id" />
        <div class="flex flex-col items-center gap-[10px]">
            <div class="rounded-[50%] h-[65px] w-[65px] flex items-center justify-center bg-[rgba(255,56,60,.2)]">
                <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M15.0005 11.2501V16.2501M5.47412 18.9998C4.33733 20.9688 3.7691 21.9537 3.85401 22.7615C3.92807 23.4662 4.29789 24.1063 4.87109 24.5228C5.52803 25.0001 6.66412 25.0001 8.93616 25.0001H21.0648C23.3369 25.0001 24.4728 25.0001 25.1297 24.5228C25.7029 24.1063 26.0729 23.4662 26.147 22.7615C26.2319 21.9537 25.6638 20.9688 24.527 18.9998L18.4648 8.49983C17.3281 6.53085 16.7594 5.54653 16.0173 5.21614C15.3701 4.92795 14.6305 4.92795 13.9832 5.21614C13.2415 5.54639 12.6732 6.53072 11.5373 8.49806L5.47412 18.9998ZM15.064 20.0001V20.1251L14.9382 20.1253V20.0001H15.064Z"
                          stroke="#FF383C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <h3 class="text-[20px] font-semibold">Are you sure?</h3>
            <p class="text-[16px] text-gray-500 font-medium max-w-[357px] text-center">
                This will delete all data about
                <span id="deleteName" class="text-[#FF383C]"></span>. This action cannot be undone.
            </p>
        </div>
        <div class="flex w-full flex-col gap-[15px]">
            <button type="submit" class=" w-full bg-[#FF383C] cursor-pointer hover:bg-[#e03235] transition-all duration-300 text-white text-[16px] font-medium py-[15px] rounded-[6px]">
                Yes, Delete Product
            </button>
            <div id="cancelDeleteBtn"
                 class="w-full cursor-pointer text-center text-gray-600 bg-white hover:bg-gray-100 transition-all duration-300 text-black text-[16px] font-medium py-[15px] rounded-[6px] border border-gray-300">
                Cancel
            </div>
        </div>
    </form>
</div>
<!-- VIEW MODAL -->
<div id="viewModal" class="fixed h-[100vh] overflow-y-auto hidden items-start p-[100px] justify-center z-[999] w-full bg-black bg-opacity-50 top-0 left-0">
    <div class="bg-white w-full max-w-[582px] shadow-lg px-[45px] flex flex-col gap-[30px] py-[30px] rounded-[20px]">
        <div class="flex items-center gap-[10px]">
            <div class="w-[75px] h-[75px] rounded-[50%] overflow-hidden min-w-[75px] bg-gray-200 flex items-center justify-center">
                <div id="modalImageContainer" class="w-[75px] h-[75px] rounded-[50%] overflow-hidden min-w-[75px] bg-gray-200 flex items-center justify-center">
                    <img id="modalImage" src="" alt="User" class="w-full h-full object-cover hidden" />
                    <svg id="modalPlaceholder" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z" stroke="#9CA3AF" stroke-width="2" />
                        <path d="M20 21C20 17.134 16.4183 14 12 14C7.58172 14 4 17.134 4 21" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </div>
            </div>
            <div class="flex flex-col gap-[5px]">
                <h1 id="modalName" class="font-medium text-[20px]"></h1>
                <p id="modalStatus" class="text-gray-500 font-medium"></p>
            </div>
        </div>
        <div class="flex flex-col gap-[10px]">
            <div class="flex items-center gap-[15px] text-[16px] text-gray-700 font-medium">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 4H7.2002C6.08009 4 5.51962 4 5.0918 4.21799C4.71547 4.40973 4.40973 4.71547 4.21799 5.0918C4 5.51962 4 6.08009 4 7.2002V8M8 4H16M8 4V2M16 4H16.8002C17.9203 4 18.4796 4 18.9074 4.21799C19.2837 4.40973 19.5905 4.71547 19.7822 5.0918C20 5.5192 20 6.07899 20 7.19691V8M16 4V2M4 8V16.8002C4 17.9203 4 18.4801 4.21799 18.9079C4.40973 19.2842 4.71547 19.5905 5.0918 19.7822C5.5192 20 6.07899 20 7.19691 20H16.8031C17.921 20 18.48 20 18.9074 19.7822C19.2837 19.5905 19.5905 19.2842 19.7822 18.9079C20 18.4805 20 17.9215 20 16.8036V8M4 8H20M16 16H16.002L16.002 16.002L16 16.002V16ZM12 16H12.002L12.002 16.002L12 16.002V16ZM8 16H8.002L8.00195 16.002L8 16.002V16ZM16.002 12V12.002L16 12.002V12H16.002ZM12 12H12.002L12.002 12.002L12 12.002V12ZM8 12H8.002L8.00195 12.002L8 12.002V12Z"
                          stroke="#595959" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span id="modalDate"></span>
            </div>
            <div class="flex items-center gap-[15px] text-[16px] text-gray-700 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#595959"><path d="M856-390 570-104q-12 12-27 18t-30 6q-15 0-30-6t-27-18L103-457q-11-11-17-25.5T80-513v-287q0-33 23.5-56.5T160-880h287q16 0 31 6.5t26 17.5l352 353q12 12 17.5 27t5.5 30q0 15-5.5 29.5T856-390ZM513-160l286-286-353-354H160v286l353 354ZM260-640q25 0 42.5-17.5T320-700q0-25-17.5-42.5T260-760q-25 0-42.5 17.5T200-700q0 25 17.5 42.5T260-640Zm220 160Z" /></svg>
                <span id="modalPrice"></span>
            </div>
            <div class="flex items-center gap-[15px] text-[16px] text-gray-700 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#595959"><path d="M200-640v440h560v-440H640v255q0 23-19 34.5t-39 1.5l-102-51-102 51q-20 10-39-1.5T320-385v-255H200Zm0 520q-33 0-56.5-23.5T120-200v-499q0-14 4.5-27t13.5-24l50-61q11-14 27.5-21.5T250-840h460q18 0 34.5 7.5T772-811l50 61q9 11 13.5 24t4.5 27v499q0 33-23.5 56.5T760-120H200Zm16-600h528l-34-40H250l-34 40Zm184 80v190l80-40 80 40v-190H400Zm-200 0h560-560Z" /></svg>
                <span id="modalStock"></span>
            </div>
        </div>
        <div class="flex w-full flex-col gap-[15px]">
            <div id="cancelViewBtn"
                 class="w-full bg-blue-500 cursor-pointer text-center hover:bg-blue-600 transition-all duration-300 text-white text-[16px] font-medium py-[15px] rounded-[6px]">
                Go Back
            </div>
        </div>
    </div>
</div>

<!-- MAIN CONTENT SECTION -->
<section class="w-full pl-[240px]">
    <!-- HEADER -->
    <div class="w-full border-b-[#E0E0E0] border-b-[1px] justify-between items-center flex bg-white px-[28px] py-[7px]">
        <form class="flex gap-[30px] items-center">
            <div class="p-[10px] flex items-center justify-center rounded-[50%] hover:bg-gray-200 cursor-pointer transition-all duration-300 ">
                <svg width="30" height="30" viewBox="0 0 30 31" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1.25 7.75001H28.75C29.0815 7.75001 29.3995 7.61393 29.6339 7.37169C29.8683 7.12946 30 6.80092 30 6.45835C30 6.11578 29.8683 5.78724 29.6339 5.54501C29.3995 5.30277 29.0815 5.16669 28.75 5.16669H1.25C0.918479 5.16669 0.600537 5.30277 0.366117 5.54501C0.131696 5.78724 0 6.11578 0 6.45835C0 6.80092 0.131696 7.12946 0.366117 7.37169C0.600537 7.61393 0.918479 7.75001 1.25 7.75001Z"
                          fill="#8A8A8A" />
                    <path d="M28.75 11.625H1.25C0.918479 11.625 0.600537 11.7611 0.366117 12.0033C0.131696 12.2456 0 12.5741 0 12.9167C0 13.2592 0.131696 13.5878 0.366117 13.83C0.600537 14.0722 0.918479 14.2083 1.25 14.2083H28.75C29.0815 14.2083 29.3995 14.0722 29.6339 13.83C29.8683 13.5878 30 13.2592 30 12.9167C30 12.5741 29.8683 12.2456 29.6339 12.0033C29.3995 11.7611 29.0815 11.625 28.75 11.625Z"
                          fill="#8A8A8A" />
                    <path d="M28.75 24.5416H1.25C0.918479 24.5416 0.600537 24.6777 0.366117 24.92C0.131696 25.1622 0 25.4907 0 25.8333C0 26.1759 0.131696 26.5044 0.366117 26.7467C0.600537 26.9889 0.918479 27.125 1.25 27.125H28.75C29.0815 27.125 29.3995 26.9889 29.6339 26.7467C29.8683 26.5044 30 26.1759 30 25.8333C30 25.4907 29.8683 25.1622 29.6339 24.92C29.3995 24.6777 29.0815 24.5416 28.75 24.5416Z"
                          fill="#8A8A8A" />
                    <path d="M28.75 18.0834H1.25C0.918479 18.0834 0.600537 18.2195 0.366117 18.4617C0.131696 18.7039 0 19.0325 0 19.375C0 19.7176 0.131696 20.0462 0.366117 20.2884C0.600537 20.5306 0.918479 20.6667 1.25 20.6667H28.75C29.0815 20.6667 29.3995 20.5306 29.6339 20.2884C29.8683 20.0462 30 19.7176 30 19.375C30 19.0325 29.8683 18.7039 29.6339 18.4617C29.3995 18.2195 29.0815 18.0834 28.75 18.0834Z"
                          fill="#8A8A8A" />
                </svg>
            </div>
            <div class="rounded-[25px] w-full max-w-[333px] border-[#E0E0E0] border-[1px] px-[15px] py-[10px] flex items-center gap-[15px]">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_11_127)">
                        <path d="M19.7557 18.5781L14.7815 13.6039C16.137 11.9461 16.8035 9.83067 16.643 7.69523C16.4826 5.55978 15.5075 3.5677 13.9195 2.13102C12.3315 0.69435 10.252 -0.076999 8.11119 -0.0234725C5.9704 0.030054 3.93207 0.90436 2.41783 2.4186C0.903588 3.93284 0.0292815 5.97117 -0.024245 8.11196C-0.0777715 10.2528 0.693577 12.3322 2.13025 13.9202C3.56693 15.5083 5.55901 16.4834 7.69445 16.6438C9.8299 16.8042 11.9453 16.1378 13.6032 14.7823L18.5773 19.7564C18.7345 19.9082 18.945 19.9922 19.1635 19.9903C19.382 19.9884 19.591 19.9008 19.7455 19.7463C19.9 19.5918 19.9877 19.3828 19.9895 19.1643C19.9914 18.9458 19.9075 18.7353 19.7557 18.5781ZM8.33315 15.0006C7.01461 15.0006 5.72568 14.6096 4.62935 13.8771C3.53302 13.1445 2.67854 12.1033 2.17395 10.8851C1.66937 9.66697 1.53735 8.32653 1.79458 7.03332C2.05182 5.74012 2.68676 4.55223 3.61911 3.61988C4.55146 2.68753 5.73934 2.05259 7.03255 1.79536C8.32576 1.53812 9.6662 1.67014 10.8844 2.17473C12.1025 2.67931 13.1437 3.53379 13.8763 4.63012C14.6088 5.72645 14.9998 7.01538 14.9998 8.33393C14.9978 10.1014 14.2948 11.796 13.045 13.0458C11.7952 14.2956 10.1007 14.9986 8.33315 15.0006Z"
                              fill="#8A8A8A" />
                    </g>
                    <defs>
                        <clipPath id="clip0_11_127">
                            <rect width="20" height="20" fill="white" />
                        </clipPath>
                    </defs>
                </svg>
                <input type="search" class="focus:outline-none text-[16px]" type="text" placeholder="Search">
            </div>
        </form>

        <div class="flex items-center gap-[30px]">
            <div class="relative rounded-[50%] h-[35px] w-[35px] min-w-[35px] w-fit group cursor-pointer hover:bg-gray-200 transition-all duration-300 flex items-center justify-center">
                <svg class="h-[24px] w-[24px]" viewBox="0 0 24 24" fill="none"
                     xmlns="http://www.w3.org/2000/svg">
                    <path d="M18.7491 9.70957V9.00497C18.7491 5.13623 15.7274 2 12 2C8.27256 2 5.25087 5.13623 5.25087 9.00497V9.70957C5.25087 10.5552 5.00972 11.3818 4.5578 12.0854L3.45036 13.8095C2.43882 15.3843 3.21105 17.5249 4.97036 18.0229C9.57274 19.3257 14.4273 19.3257 19.0296 18.0229C20.789 17.5249 21.5612 15.3843 20.5496 13.8095L19.4422 12.0854C18.9903 11.3818 18.7491 10.5552 18.7491 9.70957Z"
                          stroke="#1C274C" stroke-width="1.5" />
                    <path d="M7.5 19C8.15503 20.7478 9.92246 22 12 22C14.0775 22 15.845 20.7478 16.5 19"
                          stroke="#1C274C" stroke-width="1.5" stroke-linecap="round" />
                </svg>
                <div class="h-[15px] absolute top-0 right-0 flex text-[10px] mt-[2px] mr-[2px] text-white items-center justify-center w-[15px] bg-red-600 rounded-[50%]">
                    8
                </div>
            </div>

            <div class="flex gap-[10px] items-center">
                <div class="overflow-hidden rounded-[50%] h-[50px] w-[50px] min-w-[50px]">
                    <img class="h-full w-full object-center object-cover" src="~/Content/Images/profile_default.jpg" alt="">
                </div>
                <div class="flex flex-col">
                    <h3 class="text-[16px] text-gray-600 font-semibold">Juan Ming</h3>
                    <small class="text-gray-500 text-[12px] font-semibold">Admin</small>
                </div>
            </div>

        </div>


    </div>

    <!-- main info -->
    <div class="w-full flex flex-col gap-[30px] p-[30px]">
        <!-- FILTER -->
        <div class="w-full flex flex-col gap-[20px]">
            <h1 class="text-[32px] font-semibold">Manage Products</h1>
            <!-- FILTER -->
            <div class="w-full flex items-center justify-between">
                <form method="get" action="@Url.Action("products", "product")" class="flex w-fit items-center bg-white border-[1px] rounded-[10px] border-[#E0E0E0]">
                    <div class="border-r-[#E0E0E0] border-r-[1px] w-fit px-[30px] py-[25px]">
                        <svg width="21" height="24" viewBox="0 0 21 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd"
                                  d="M10.5 9.75C15.8848 9.75 20.25 7.73528 20.25 5.25C20.25 2.76472 15.8848 0.75 10.5 0.75C5.11522 0.75 0.75 2.76472 0.75 5.25C0.75 7.73528 5.11522 9.75 10.5 9.75Z"
                                  stroke="black" stroke-width="1.5" stroke-linecap="round"
                                  stroke-linejoin="round" />
                            <path d="M0.75 5.25C0.75253 9.76548 3.85614 13.688 8.25 14.729V21C8.25 22.2426 9.25736 23.25 10.5 23.25C11.7426 23.25 12.75 22.2426 12.75 21V14.729C17.1439 13.688 20.2475 9.76548 20.25 5.25"
                                  stroke="black" stroke-width="1.5" stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="border-r-[#E0E0E0] text-[14px] font-medium border-r-[1px] w-fit px-[30px] py-[25px]">
                        Filter By
                    </div>
                    <div class="border-r-[#E0E0E0] group cursor-pointer text-[14px] font-medium border-r-[1px] w-fit px-[30px] py-[25px]">
                        <select name="statusFilter"
                                onchange="this.form.submit()"
                                class="focus:outline-none group-hover:cursor-pointer">
                            <option value="">All Products</option>
                            <option value="1" @(ViewBag.CurrentFilter == 1 ? "selected" : "")>Available</option>
                            <option value="0" @(ViewBag.CurrentFilter == 0 ? "selected" : "")>Unavailable</option>
                        </select>
                    </div>
                    <a href="@Url.Action("products", "product")"
                       class="flex items-center gap-[10px] group cursor-pointer text-[14px] text-[#EA0234] hover:text-[#c00128] transition-all font-medium w-fit px-[30px] py-[25px]">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M9.99992 4.16666V0.833328L5.83325 4.99999L9.99992 9.16666V5.83333C12.7583 5.83333 14.9999 8.07499 14.9999 10.8333C14.9999 13.5917 12.7583 15.8333 9.99992 15.8333C7.24159 15.8333 4.99992 13.5917 4.99992 10.8333H3.33325C3.33325 14.5167 6.31659 17.5 9.99992 17.5C13.6833 17.5 16.6666 14.5167 16.6666 10.8333C16.6666 7.14999 13.6833 4.16666 9.99992 4.16666Z"
                                  fill="currentColor" />
                        </svg>
                        Reset Filter
                    </a>
                </form>

                <a href="@Url.Action("addProduct", "product")"
                   class="flex bg-white transition-all duration-300 hover:bg-gray-50 cursor-pointer rounded-[10px] border-[1px] border-gray-300 items-center gap-[10px] group cursor-pointer text-[14px] text-black font-medium w-fit px-[30px] py-[25px]">
                    <svg class="w-[20px] h-[20px] stroke-black" width="20" height="20" viewBox="0 0 24 24"
                         fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 3H3.26835C3.74213 3 3.97943 3 4.17267 3.08548C4.34304 3.16084 4.48871 3.28218 4.59375 3.43604C4.71269 3.61026 4.75564 3.8429 4.84137 4.30727L7.00004 16L17.4218 16C17.875 16 18.1023 16 18.29 15.9199C18.4559 15.8492 18.5989 15.7346 18.7051 15.5889C18.8252 15.4242 18.8761 15.2037 18.9777 14.7631L18.9785 14.76L20.5477 7.95996L20.5481 7.95854C20.7023 7.29016 20.7796 6.95515 20.6947 6.69238C20.6202 6.46182 20.4635 6.26634 20.2556 6.14192C20.0184 6 19.6758 6 18.9887 6H5.5M18 21C17.4477 21 17 20.5523 17 20C17 19.4477 17.4477 19 18 19C18.5523 19 19 19.4477 19 20C19 20.5523 18.5523 21 18 21ZM8 21C7.44772 21 7 20.5523 7 20C7 19.4477 7.44772 19 8 19C8.55228 19 9 19.4477 9 20C9 20.5523 8.55228 21 8 21Z"
                              stroke="" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Add new Product
                </a>
            </div>

        </div>
        <!-- TABLE -->
        <div class="w-full p-[30px] rounded-[20px] gap-[20px] bg-white flex flex-col">
            <table class="w-full">
                <thead>
                    <tr class="bg-[#F1F4F9] px-[10px] py-[15px]">
                        <th class="text-[14px] rounded-tl-[10px] rounded-bl-[10px] px-[10px] py-[15px] font-semibold text-start">
                            Product Name
                        </th>
                        <th class="text-[14px] px-[10px] py-[15px] font-semibold text-start">
                            Category
                        </th>
                        <th class="text-[14px] px-[10px] py-[15px] font-semibold text-start">
                            Price
                        </th>
                        <th class="text-[14px] px-[10px] py-[15px] font-semibold text-start">
                            Stock
                        </th>
                        <th class="text-[14px] px-[10px] py-[15px] font-semibold text-start">
                            Status
                        </th>
                        <th class="text-[14px] rounded-tr-[10px] rounded-br-[10px] px-[10px] py-[15px] font-semibold text-start">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td class="text-[14px] px-[10px] py-[15px] font-medium text-gray-700 text-start">
                                @product.Name
                            </td>
                            <td class="text-[14px] px-[10px] py-[15px] font-medium text-gray-700 text-start">
                                Cakes
                            </td>
                            <td class="text-[14px] px-[10px] py-[15px] font-medium text-gray-700 text-start">
                                ₱@product.Price
                            </td>
                            <td class="text-[14px] px-[10px] py-[15px] font-medium text-gray-700 text-start">
                                @product.Stock
                            </td>
                            <td class="text-[14px] px-[10px] py-[15px] font-medium text-gray-700 text-start">
                                <div class="
                                     @(product.Status == 0 ? "text-[#7900b6] bg-[rgb(121,0,182,0.2)]" : "text-[#00B69B] bg-[rgba(0,182,155,.2)]" )
                                     w-fit px-[15px] py-[8px] rounded-[5px]">
                                    @(product.Status == 1 ? "Available" : "Unavailable")
                                </div>
                            </td>
                            <td class="text-[14px] px-[10px] flex items-center gap-[10px] py-[15px] font-medium text-start">
                                <a href="@Url.Action("editProduct", "Product", new { id = product.Product_id })"
                                   class="text-[#FF8D28] hover:bg-[rgba(255,141,40,.3)] transition-all duration-300 cursor-pointer bg-[rgba(255,141,40,.2)] w-fit px-[15px] py-[8px] rounded-[5px]">
                                    Edit
                                </a>
                                <div data-id="@product.Product_id"
                                     data-name="@($"{product.Name}")"
                                     class="openDeleteBtn text-[#FF383C]  hover:bg-[rgba(255,56,60,.3)] transition-all duration-300 cursor-pointer bg-[rgba(255,56,60,.2)] w-fit px-[15px] py-[8px] rounded-[5px]">
                                    Delete
                                </div>
                                <div data-name="@product.Name"
                                     data-price="@product.Price"
                                     data-date="@product.Created_at"
                                     data-photo="@product.ExistingPhoto"
                                     data-stock="@product.Stock"
                                     data-status="@(product.Status == 0 ? "Unavavailable" : "Available")"
                                     class="text-[#155dfc] viewBtn hover:bg-[rgba(21,93,252,.3)] transition-all duration-300 cursor-pointer bg-[rgba(21,93,252,.2)] w-fit px-[15px] py-[8px] rounded-[5px]">
                                    View
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>

    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('viewModal');
        const cancelBtn = document.getElementById('cancelViewBtn');
        const viewButtons = document.querySelectorAll('.viewBtn');
        const modalImage = document.getElementById('modalImage');
        const modalPlaceholder = document.getElementById('modalPlaceholder');

        // Open modal
        viewButtons.forEach(button => {
            button.addEventListener('click', function () {
                const name = this.dataset.name;
                const price = this.dataset.price;
                const date = this.dataset.date;
                const status = this.dataset.status;
                const stock = this.dataset.stock;
                const photo = this.dataset.photo; // Get photo path

                // Populate modal with null/empty checks
                document.getElementById('modalName').textContent = name || 'N/A';
                document.getElementById('modalPrice').textContent = price || 'N/A';
                document.getElementById('modalDate').textContent = date || 'N/A';
                document.getElementById('modalStatus').textContent = status || 'N/A';
                document.getElementById('modalStock').textContent = stock || 'N/A';

                // Handle image display
                if (photo && photo.trim() !== '') {
                    modalImage.src = photo;
                    modalImage.classList.remove('hidden');
                    modalPlaceholder.classList.add('hidden');
                } else {
                    modalImage.classList.add('hidden');
                    modalPlaceholder.classList.remove('hidden');
                }

                // Show modal
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            });
        });

        // Close modal
        cancelBtn.addEventListener('click', function () {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        });

        // Close modal when clicking outside
        modal.addEventListener('click', function (e) {
            if (e.target === modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        });
    });
    document.addEventListener("DOMContentLoaded", function () {

        const deleteModal = document.getElementById("deleteModal");
        const deleteProductId = document.getElementById("deleteProductId");
        const deleteName = document.getElementById("deleteName");

        const openButtons = document.querySelectorAll(".openDeleteBtn");
        const cancelDeleteButton = document.getElementById("cancelDeleteBtn");

        openButtons.forEach(btn => {
            btn.addEventListener("click", function () {
                const id = this.getAttribute("data-id");
                const name = this.getAttribute("data-name");

                deleteProductId.value = id;
                deleteName.textContent = name;

                deleteModal.classList.remove("hidden");
                deleteModal.classList.add("flex");
            });
        });

        cancelDeleteButton.addEventListener("click", function () {
            deleteModal.classList.add("hidden");
            deleteModal.classList.remove("flex");
        });

    });
</script>
