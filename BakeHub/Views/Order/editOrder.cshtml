    <div class="w-full flex flex-col gap-[30px] p-[30px]">
        <div class="flex items-start justify-center w-full items-center">
            <form class="bg-white w-full max-w-[700px] shadow-lg px-[45px] flex flex-col gap-[20px] py-[30px] rounded-[20px]">
                <div class="border-b-[1px] border-b-[#] py-[5px] text-[20px] font-semibold text-gray-500">
                    Edit order
                    informations
                </div>
                <div class="flex items-center gap-[20px]">
                    <div class="flex flex-col w-full gap-[5px]">
                        <label class="text-[14px] text-gray-600 font-semibold" for="">Firstname</label>
                        <input placeholder="Ex: Juan" value="Juan"
                               class="rounded-[5px] px-[15px] py-[8px] text-[16px] font-normal border-[1px] border-gray-300 focus:outline-none"
                               type="text">
                    </div>
                    <div class="flex flex-col w-full gap-[5px]">
                        <label class="text-[14px] text-gray-600 font-semibold" for="">Firstname</label>
                        <input placeholder="Ex: Santos" value="Santos"
                               class="rounded-[5px] px-[15px] py-[8px] text-[16px] font-normal border-[1px] border-gray-300 focus:outline-none"
                               type="text">
                    </div>
                </div>
                <div class="flex flex-col w-full gap-[5px]">
                    <label class="text-[14px] text-gray-600 font-semibold" for="">Contact</label>
                    <input placeholder="Ex: 0986512321" value="0986512321"
                           class="rounded-[5px] px-[15px] py-[8px] text-[16px] font-normal border-[1px] border-gray-300 focus:outline-none"
                           type="tel">
                </div>
                <div class="flex flex-col w-full gap-[5px]">
                    <label class="text-[14px] text-gray-600 font-semibold" for="">Category</label>
                    <Select class="rounded-[5px] px-[15px] py-[8px] text-[16px] font-normal border-[1px] border-gray-300 focus:outline-none">
                        <option value="">Cupcakes</option>
                        <option value="">Cake</option>
                    </Select>
                </div>
                <div class="flex flex-col w-full gap-[5px]">
                    <label class="text-[14px] text-gray-600 font-semibold" for="">Product</label>
                    <Select class="rounded-[5px] px-[15px] py-[8px] text-[16px] font-normal border-[1px] border-gray-300 focus:outline-none">
                        <option value="">Sweet Strawberry Cupcakes</option>
                        <option value="">Cake</option>
                    </Select>
                </div>
                <div class="flex items-center gap-[20px]">
                    <div class="flex flex-col w-full gap-[5px]">
                        <label class="text-[14px] text-gray-600 font-semibold" for="">Piece</label>
                        <input placeholder="Ex: 10" value="30"
                               class="rounded-[5px] px-[15px] py-[8px] text-[16px] font-normal border-[1px] border-gray-300 focus:outline-none"
                               type="number">
                    </div>
                    <div class="flex flex-col w-full gap-[5px]">
                        <label class="text-[14px] text-gray-600 font-semibold" for="">Amount(₱)</label>
                        <input placeholder="00.00" value="120.00" readonly
                               class="rounded-[5px] px-[15px] py-[8px] text-[16px] font-normal border-[1px] border-gray-300 focus:outline-none"
                               type="number" step="0.01">
                    </div>
                </div>
                <div class="flex flex-col w-full gap-[5px]">
                    <label class="text-[14px] text-gray-600 font-semibold" for="">Address</label>
                    <textarea placeholder="Ex: 1234 Street, City, Country"
                              class="rounded-[5px] resize-none min-h-[100px] px-[15px] py-[8px] text-[16px] font-normal border-[1px] border-gray-300 focus:outline-none"
                              name="" id="">1234 Mabini Street, Quezon City, Philippines</textarea>
                </div>
                <div class="flex flex-col gap-[5px]">
                    <label class="text-[14px] text-gray-600 font-semibold" for="">Status</label>
                    <div class="flex items-center gap-[20px]">
                        <div class="flex items-center gap-[10px]">
                            <input type="radio" name="role" class="cursor-pointer  scale-150" checked>
                            <label class="text-[16px]" for="">Delivered</label>
                        </div>
                        <div class="flex items-center gap-[10px]">
                            <input type="radio" name="role" class="cursor-pointer  scale-150">
                            <label class="text-[16px]" for="">In-Transit</label>
                        </div>
                        <div class="flex items-center gap-[10px]">
                            <input type="radio" name="role" class="cursor-pointer  scale-150">
                            <label class="text-[16px]" for="">Processing</label>
                        </div>
                        <div class="flex items-center gap-[10px]">
                            <input type="radio" name="role" class="cursor-pointer  scale-150">
                            <label class="text-[16px]" for="">Cancelled</label>
                        </div>
                    </div>
                </div>

                <div class="flex w-full flex-col gap-[15px]">
                    <button class="w-full bg-blue-500 cursor-pointer hover:bg-blue-600 transition-all duration-300 text-white text-[16px] font-medium py-[15px] rounded-[6px]">
